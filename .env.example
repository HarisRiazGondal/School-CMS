DJANGO_SECRET_KEY=replace-in-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# For deployment set DJANGO_DEBUG=false and provide a generated secret of at least 50 characters.
# Password reset email uses console output in development; configure SMTP in deployment:
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=School-CMS <no-reply@example.com>
# Enable HSTS only after validating HTTPS for every served hostname:
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_HSTS_PRELOAD=false
